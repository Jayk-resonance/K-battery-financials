age": 2, "ampc_basis": "incl"}, {"company": "LG에너지솔루션", "segment": "중대형", "segment_std": "중대형", "fy": 2025, "period": "2Q", "metric": "영업이익", "value": 424, "unit": "십억원", "page": 2, "ampc_basis": "incl"}, {"company": "LG에너지솔루션", "segment": "중대형", "segment_std": "중대형", "fy": 2025, "period": "3Q", "metric": "영업이익", "value": 510, "unit": "십억원", "page": 2, "ampc_basis": "incl"}, {"company": "LG에너지솔루션", "segment": "중대형", "segment_std": "중대형", "fy": 2025, "period": "4Q", "metric": "영업이익", "value": -261, "unit": "십억원", "page": 2, "ampc_basis": "incl"}, {"company": "LG에너지솔루션", "segment": "중대형", "segment_std": "중대형", "fy": 2026, "period": "1Q", "metric": "영업이익", "value": -291, "unit": "십억원", "page": 2, "ampc_basis": "incl"}, {"company": "LG에너지솔루션", "segment": "중대형", "segment_std": "중대형", "fy": 2026, "period": "2Q", "metric": "영업이익", "value": -59, "unit": "십억원", "page": 2, "ampc_basis": "incl"}, {"company": "LG에너지솔루션", "segment": "중대형", "segment_std": "중대형", "fy": 2026, "period": "3Q", "metric": "영업이익", "value": 355, "unit": "십억원", "page": 2, "ampc_basis": "incl"}, {"company": "LG에너지솔루션", "segment": "중대형", "segment_std": "중대형", "fy": 2026, "period": "4Q", "metric": "영업이익", "value": 743, "unit": "십억원", "page": 2, "ampc_basis": "incl"}], "stances": [{"issue": "ESS", "company": "LG에너지솔루션", "stance_score": 6, "summary": "2026년말 북미 ESS 생산능력을 수요 호조와 점유율 확대를 반영해 기존 50GWh에서 57GWh로 상향 조정하고 ESS 매출은 전년 대비 225% 증가할 전망", "page": 1}, {"issue": "AMPC", "company": "LG에너지솔루션", "stance_score": 4, "summary": "AMPC(생산세액공제)가 1.2조원으로 전체 영업이익 중 78%를 차지하며 이익 기여도가 확대되고 있음", "page": 1}, {"issue": "북미EV", "company": "LG에너지솔루션", "stance_score": -6, "summary": "미국 얼티엄셀즈(GM JV) 가동 중단에 따른 판매량 감소로 1분기 자동차 전지 매출이 24% 감소하고 영업이익 적자가 지속될 전망", "page": 1}, {"issue": "유럽EV", "company": "LG에너지솔루션", "stance_score": 3, "summary": "유럽 가동률이 고전압 미드니켈 및 LFP 공급 확대에 힘입어 회복되며 하반기 실적 개선 방향성이 유효할 전망", "page": 1}, {"issue": "소형전지", "company": "LG에너지솔루션", "stance_score": 0, "summary": "파우치 비수기로 적자전환이 예상되나 북미 EV 고객사의 견조한 차량 판매 효과로 원통형 출하량 증가는 지속될 전망", "page": 1}, {"issue": "밸류에이션", "company": "LG에너지솔루션", "stance_score": 5, "summary": "타이트한 리튬 수급에 따른 판가 방향성 개선과 ESS Capa 확대, 점진적인 EV 회복을 근거로 목표주가 51만원과 매수 의견을 유지하며 실적 저점을 1분기로 판단", "page": 1}], "industry_views": [{"scope": "북미ESS", "fy": 2026, "metric": "생산능력", "value": 57, "unit": "GWh", "direction": 2, "summary": "2026년말 북미 ESS 생산능력을 수요 호조와 점유율 확대를 반영해 기존 50GWh에서 57GWh로 상향 조정", "page": 1}, {"scope": "메탈가격", "fy": 2026, "metric": "리튬가격", "value": null, "unit": null, "direction": 2, "summary": "타이트한 리튬 수급에 따른 가격 강세로 배터리 판가 방향성이 긍정적이라고 판단", "page": 1}], "top_picks": [], "body": {"summary": "신한투자증권은 LG에너지솔루션에 대해 투자의견 매수, 목표주가 51만원을 유지했다. 2026년말 북미 ESS 생산능력을 기존 50GWh에서 57GWh로 상향 조정했고, ESS용 매출은 전년 대비 225% 증가하며 AMPC(1.2조원, 이익 중 78% 비중)와 함께 이익 기여도가 확대될 전망이다. 반면 EV용 실적은 얼티엄셀즈(GM JV) 가동 중단에 따른 북미 판매 부진으로 전년 대비 둔화가 예상되나, 유럽 가동률 회복(고전압 미드니켈, LFP)과 원통형 출하량 증가로 하반기 개선 흐름은 유효하다고 판단했다. 1분기는 EV 부진으로 컨센서스를 하회하는 영업적자(-1,609억원)가 예상되지만, 이를 저점으로 매분기 증익 추세가 이어질 것으로 전망했다.", "valuation": "목표주가 51만원, 투자의견 매수 유지(직전 대비 변동 없음). SOTP 방식으로 2027년 예상 EBITDA 9조 90.5십억원에 글로벌 셀 업체 평균 대비 30% 할증한 15.5배를 적용해 영업가치 14조 816억원을 산출하고, 자산가치 120십억원을 더하고 2027년 기준 순차입금 2조 1,055억원을 차감해 목표 시가총액 11조 9,881억원을 도출했다. 발행주식수 234,000천주로 나눈 목표주가는 51만원이다. 리비전 항목에는 실적추정치 상향, Valuation 하향이 명시되어 있으나 목표주가 자체는 직전(2026년 1월 7일, 51만원)과 동일하게 유지됐다.", "segment_pl": "1분기 매출액은 전 분기 대비 4.6% 감소한 5조 8,570억원, 영업이익은 -1,609억원(적자확대)으로 컨센서스(-1,244억원)를 하회할 전망이다. 자동차 전지(EV) 매출액은 미국 얼티엄셀즈(GM JV) 가동 중단에 따른 판매량 감소 등으로 24% 감소했고, 영업이익은 AMPC 소멸 및 저율 가동 영향으로 -4,859억원(적자지속)으로 전망된다. ESS용 매출액은 견조한 수요 속 신규 공장 가동 효과가 지속되며 35% 증가할 전망이며, 영업이익은 일회성 소멸 및 AMPC 증가 등으로 큰 폭 개선이 예상되나 라인 전환에 따른 램프업 비용이 지속 반영되며 수익성 눈높이는 하향 조정이 불가피하다. 소형 전지 매출액은 2.0조원(-0.1%), 영업이익은 1,296억원(-6%)으로 전망되며, 파우치 비수기에 따른 적자전환이 예상되나 고객사(북미 EV)의 견조한 차량 판매 효과로 EV 원통형 출하량 증가는 지속될 전망이다.\n\n| 구분(십억원) | 1Q25 | 2Q25 | 3Q25 | 4Q25 | 1Q26F | 2Q26F | 3Q26F | 4Q26F | 2025 | 2026F | 2027F |\n|---|---|---|---|---|---|---|---|---|---|---|---|\n| 매출액 | 6,265 | 5,565 | 5,700 | 6,142 | 5,857 | 6,318 | 6,875 | 7,809 | 23,672 | 26,859 | 33,950 |\n| 소형(원통+파우치) | 1,660 | 1,575 | 1,693 | 1,965 | 1,962 | 1,982 | 1,997 | 1,897 | 6,893 | 7,839 | 8,152 |\n| 중대형(EV+ESS) | 4,605 | 3,990 | 4,007 | 4,176 | 3,895 | 4,336 | 4,877 | 5,912 | 16,778 | 19,020 | 25,798 |\n| EV | 4,213 | 3,655 | 3,478 | 2,923 | 2,209 | 2,258 | 2,560 | 2,820 | 14,270 | 9,847 | 12,271 |\n| ESS | 391 | 335 | 529 | 1,253 | 1,686 | 2,078 | 2,317 | 3,091 | 2,508 | 9,172 | 13,528 |\n| 영업이익 | 375 | 492 | 601 | (122) | (161) | 59 | 480 | 848 | 1,346 | 1,225 | 4,668 |\n| AMPC | 458 | 491 | 366 | 333 | 170 | 263 | 472 | 642 | 1,647 | 1,547 | 3,289 |\n\n연간으로는 2026년 EV 매출이 북미 시장 부진으로 전년 대비 31% 감소하는 반면 ESS 매출은 신규 공장 가동 효과로 266% 급증하며 중대형 매출 성장을 견인한다.", "issue_comments": "ESS: 2026년말 북미 ESS 생산능력을 기존 50GWh에서 57GWh로 상향 조정했으며, 견조한 수요와 신규 공장 가동 효과로 ESS 매출 성장과 이익 기여 확대가 지속될 전망이다.\nAMPC: 2026년 AMPC 예상 금액은 1.2조원으로 전체 영업이익 중 78%를 차지하며 이익 기여도가 확대되고 있다.\n북미EV/자동차전지: 얼티엄셀즈(GM JV) 가동 중단이 1분기 실적 부진의 핵심 원인으로 판매량 감소와 저율 가동에 따른 영업적자 지속을 초래했다.\n유럽EV: 고전압 미드니켈, LFP 공급 확대로 유럽 가동률 회복 추세가 이어지며 하반기 개선 방향성에 기여할 전망이다.\n소형전지: 파우치 비수기에 따른 적자전환이 예상되나 북미 EV 고객사의 견조한 차량 판매로 원통형 출하량 증가가 지속되고 있다.", "risks": "북미 EV 시장 부진 및 얼티엄셀즈(GM JV) 가동 중단 장기화 시 자동차 전지 매출·이익 회복이 지연될 수 있다. 라인 전환에 따른 램프업 비용이 지속 반영되며 ESS 부문 수익성 눈높이가 추가로 하향 조정될 가능성이 있다.", "quotes": "\"2026년말 북미 ESS 생산능력은 수요 호조 속 점유율 확대 등을 반영해 57GWh(기존 50GWh)으로 상향 조정\" (p.1)\n\"AMPC(생산세액공제)는 1.2조원으로 전체 금액 중 78% 차지하며 이익 기여도 확대\" (p.1)\n\"1Q26 영업이익 -1,609억원(적자확대, 이하 QoQ)으로 컨센서스(-1,244억원) 하회 예상. 자동차 전지 매출액은 미국 얼티엄셀즈(GM JV) 가동 중단에 따른 판매량 감소 등으로 24% 감소\" (p.1)\n\"목표주가 510,000원, 투자의견 '매수' 유지. 타이트한 수급에 따른 리튬 강세로 판가 방향성은 긍정적\" (p.1)\n\"출하량은 ESS Capa 확대 및 점진적인 EV향 회복이 예상되는 가운데 1분기 실적을 저점으로 매분기 증익 추세 예상\" (p.1)"}}