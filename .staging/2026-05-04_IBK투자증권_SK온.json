{"report_id": "2026-05-04_IBK투자증권_SK온", "date": "2026-05-04", "house": "IBK투자증권", "analyst": "이동욱", "coverage": "SK온", "report_type": "기업", "opinion": "매수", "target_price": 200000, "prev_target_price": 165000, "key_issues": ["정유사업 공급 측 충격(러시아 정유설비 타격, 호르무즈 봉쇄 이슈, 세계 정제설비 순증설 제한)에 따른 정제마진 구조적 지지", "등/경유 재고 타이트 및 래깅효과로 인한 1분기 실적 서프라이즈", "화학사업 올레핀 래깅효과 및 PX 스프레드 개선", "배터리/소재부문 적자 지속(구체 수치 미공개)", "실적 개선을 반영한 목표주가 상향(165,000원 → 200,000원)"], "estimates": [{"company": "SK이노베이션", "segment": "연결", "segment_std": "전사", "fy": 2024, "period": "FY", "metric": "매출", "value": 74270, "unit": "십억원", "page": 1, "ampc_basis": "na"}, {"company": "SK이노베이션", "segment": "연결", "segment_std": "전사", "fy": 2024, "period": "FY", "metric": "영업이익", "value": 356, "unit": "십억원", "page": 1, "ampc_basis": "na"}, {"company": "SK이노베이션", "segment": "연결", "segment_std": "전사", "fy": 2025, "period": "FY", "metric": "매출", "value": 80296, "unit": "십억원", "page": 1, "ampc_basis": "na"}, {"company": "SK이노베이션", "segment": "연결", "segment_std": "전사", "fy": 2025, "period": "FY", "metric": "영업이익", "value": 449, "unit": "십억원", "page": 1, "ampc_basis": "na"}, {"company": "SK이노베이션", "segment": "연결", "segment_std": "전사", "fy": 2026, "period": "FY", "metric": "매출", "value": 97887, "unit": "십억원", "page": 1, "ampc_basis": "na"}, {"company": "SK이노베이션", "segment": "연결", "segment_std": "전사", "fy": 2026, "period": "FY", "metric": "영업이익", "value": 4142, "unit": "십억원", "page": 1, "ampc_basis": "na"}, {"company": "SK이노베이션", "segment": "연결", "segment_std": "전사", "fy": 2027, "period": "FY", "metric": "매출", "value": 116025, "unit": "십억원", "page": 1, "ampc_basis": "na"}, {"company": "SK이노베이션", "segment": "연결", "segment_std": "전사", "fy": 2027, "period": "FY", "metric": "영업이익", "value": 3574, "unit": "십억원", "page": 1, "ampc_basis": "na"}, {"company": "SK이노베이션", "segment": "연결", "segment_std": "전사", "fy": 2028, "period": "FY", "metric": "매출", "value": 97759, "unit": "십억원", "page": 1, "ampc_basis": "na"}, {"company": "SK이노베이션", "segment